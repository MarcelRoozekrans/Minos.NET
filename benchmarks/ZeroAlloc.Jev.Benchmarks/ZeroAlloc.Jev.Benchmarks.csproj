<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>ZeroAlloc.Jev.Benchmarks</RootNamespace>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ZeroAlloc.Jev\ZeroAlloc.Jev.csproj" />
    <ProjectReference Include="..\..\src\ZeroAlloc.Jev.DependencyInjection\ZeroAlloc.Jev.DependencyInjection.csproj" />
    <ProjectReference Include="..\..\src\ZeroAlloc.Jev.Generator\ZeroAlloc.Jev.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\ZeroAlloc.Jev.Analyzers\ZeroAlloc.Jev.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <!-- The AOT smoke app's discarding logger factory and yielding handler, one file each for both, so the two measure the same things. -->
    <Compile Include="..\..\samples\ZeroAlloc.Jev.AotSmoke\DiscardingLoggerFactory.cs" Link="Shared\DiscardingLoggerFactory.cs" />
    <Compile Include="..\..\samples\ZeroAlloc.Jev.AotSmoke\YieldingHandler.cs" Link="Shared\YieldingHandler.cs" />
    <Compile Include="..\..\samples\ZeroAlloc.Jev.AotSmoke\DiscardingTelemetry.cs" Link="Shared\DiscardingTelemetry.cs" />
  </ItemGroup>
</Project>
