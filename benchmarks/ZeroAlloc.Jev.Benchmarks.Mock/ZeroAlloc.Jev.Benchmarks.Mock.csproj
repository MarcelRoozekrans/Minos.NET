<Project Sdk="Microsoft.NET.Sdk">
  <!-- The benchmark mock: a minimal Kestrel endpoint that serves one recorded Jev answer and counts what it serves. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ZeroAlloc.Jev.Benchmarks.Mock</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared parser and setter of the cores option, one file for the mock and the harness. -->
    <Compile Include="..\Shared\CoreAffinity.cs" Link="Shared\CoreAffinity.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The recorded answer the host serves, copied next to the executable and loaded from disk at startup. -->
    <None Include="..\compare\workload\response.json" Link="response.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
