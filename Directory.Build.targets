<Project>
  <!--
    Release packaging for the packable projects.
    This file is imported after each project body, so it sees the IsPackable a csproj sets; Directory.Build.props is
    imported before the body and would not.
    - A .snupkg symbol package sits beside each .nupkg; nuget.org takes it with the same push.
    - Package validation checks each package for compatibility problems. Its baseline, the published 1.0.0, is set after the first release, #28.
    - On GitHub Actions the build is deterministic, so Source Link maps the PDBs to the repository's commit, not to the runner's paths.
      The packable projects get it, and so do the Roslyn components (generator, analyzers, code fixes): they are not packable themselves,
      but their DLLs are packed into Minos.NET's analyzers folder. Test projects stay out: deterministic paths turn CallerFilePath
      into /_/..., which breaks tests that read the source tree.
  -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>
  <PropertyGroup Condition="('$(IsPackable)' != 'false' Or '$(IsRoslynComponent)' == 'true') And '$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
