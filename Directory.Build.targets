<Project>
  <!--
    Release packaging for the packable projects.
    This file is imported after each project body, so it sees the IsPackable a csproj sets; Directory.Build.props is
    imported before the body and would not.
    - A .snupkg symbol package sits beside each .nupkg; nuget.org takes it with the same push.
    - Package validation checks each package for compatibility problems, and compares its public API with the first version
      on nuget.org, 1.0.1, so a breaking change fails the pack (#28). Raise the baseline only on purpose, at a major release.
      The six packages published at 1.0.1 are checked against it; Minos.NET.Evaluation, first published at 1.2.0, sets its
      own baseline to 1.2.0. A library that has not shipped, such as
      Minos.NET.Recording, sets MinosNoValidationBaseline to true until its first release, is checked for compatibility
      only, and then replaces that property in its csproj with PackageValidationBaselineVersion set to that version; a
      project's own PackageValidationBaselineVersion is kept. Tool packages are excluded because the SDK turns package
      validation off for them.
    - On GitHub Actions the build is deterministic, so Source Link maps the PDBs to the repository's commit, not to the runner's paths.
      The packable projects get it, and so do the Roslyn components (generator, analyzers, code fixes): they are not packable themselves,
      but their DLLs are packed into Minos.NET's analyzers folder. Test projects stay out: deterministic paths turn CallerFilePath
      into /_/..., which breaks tests that read the source tree.
  -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsPackable)' != 'false' And '$(PackAsTool)' != 'true' And '$(MinosNoValidationBaseline)' != 'true' And '$(PackageValidationBaselineVersion)' == ''">
    <PackageValidationBaselineVersion>1.0.1</PackageValidationBaselineVersion>
  </PropertyGroup>
  <PropertyGroup Condition="('$(IsPackable)' != 'false' Or '$(IsRoslynComponent)' == 'true') And '$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
