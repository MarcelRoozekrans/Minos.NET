<Project>
  <!-- Build settings shared by all projects -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!--
      Public API surface lock: RS0016 (missing entry) / RS0017 (extra entry) are
      errors even if TreatWarningsAsErrors is locally disabled, so the public API
      tracking files can never silently drift out of sync with the codebase.
    -->
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
    <!-- Only audit direct dependencies; transitive vulnerability warnings are owned by upstream packages -->
    <NuGetAuditMode>direct</NuGetAuditMode>
    <!--
      The last released version, from release-please's manifest, which the release commit bumps: a build of the tagged
      commit carries that release's version, and any other build carries the last release's. CI passes no -p:Version=.
      The SDK appends the commit to the informational version, as in 0.3.3+<sha>, so a build between releases stays
      distinguishable from the release itself. Only a semantic version under the manifest's "." key is taken; anything
      else leaves the version empty, and the JevCheckReleaseVersion target below fails the build naming the problem.
    -->
    <JevReleaseManifest>$(MSBuildThisFileDirectory).release-please-manifest.json</JevReleaseManifest>
    <JevReleaseVersion Condition="Exists('$(JevReleaseManifest)')">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(JevReleaseManifest)')), '(?&lt;="\."\s*:\s*")[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?(?=")'))</JevReleaseVersion>
    <Version Condition="'$(JevReleaseVersion)' != ''">$(JevReleaseVersion)</Version>
  </PropertyGroup>

  <!-- NuGet metadata -->
  <PropertyGroup>
    <Authors>Marcel Roozekrans</Authors>
    <Company>Marcel Roozekrans</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://jev.zeroalloc.net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ZeroAlloc-Net/ZeroAlloc.Jev</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <Copyright>Copyright © Marcel Roozekrans</Copyright>
    <PackageTags>jev;typesafe;ai;system-one;openrouter;client;sdk;source-generator;aot;native-aot;zero-allocation</PackageTags>
  </PropertyGroup>

  <!-- Pack root README and icon into every NuGet package -->
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md"
          Pack="true" PackagePath="" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)assets\icon.png"
          Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <!-- Disable packing for test and benchmark projects -->
  <PropertyGroup Condition="$(MSBuildProjectName.Contains('.Tests')) Or
                            $(MSBuildProjectName.Contains('.Benchmarks'))">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Global analyzers (PrivateAssets=all — do not flow to consumers) -->
  <ItemGroup Condition="'$(IsRoslynComponent)' != 'true'">
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
    <PackageReference Include="Roslynator.Analyzers" PrivateAssets="all" />
    <PackageReference Include="NetFabric.Hyperlinq.Analyzer" PrivateAssets="all" />
    <PackageReference Include="ZeroAlloc.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- Fails before any build or pack whose version could not be read from the release manifest, instead of building it as 1.0.0. -->
  <Target Name="JevCheckReleaseVersion" BeforeTargets="BeforeBuild;GenerateNuspec">
    <Error Condition="!Exists('$(JevReleaseManifest)')"
           Text="The release manifest $(JevReleaseManifest) is missing. The build reads the version from it; restore the file from git." />
    <Error Condition="Exists('$(JevReleaseManifest)') And '$(JevReleaseVersion)' == ''"
           Text="The release manifest $(JevReleaseManifest) has no semantic version under its &quot;.&quot; key, such as { &quot;.&quot;: &quot;0.3.3&quot; }. Fix the file; the build reads the version from it." />
  </Target>
</Project>
