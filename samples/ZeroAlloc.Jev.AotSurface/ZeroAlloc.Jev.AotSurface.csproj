<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Publishes with Native AOT and roots ZeroAlloc.Jev and ZeroAlloc.Jev.DependencyInjection whole, so ILC analyses
    every public member for trim and AOT safety, not only the members an app happens to call. It also roots this
    assembly, so every member the generator emits for SurfaceTriage is analysed too. Every warning is an error,
    including IL2xxx and IL3xxx, and none is suppressed. CI publishes it in the aot-surface job; it is never run.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ZeroAlloc.Jev.AotSurface</RootNamespace>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <TrimMode>full</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="ZeroAlloc.Jev" />
    <TrimmerRootAssembly Include="ZeroAlloc.Jev.DependencyInjection" />
    <TrimmerRootAssembly Include="ZeroAlloc.Jev.AotSurface" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ZeroAlloc.Jev\ZeroAlloc.Jev.csproj" />
    <ProjectReference Include="..\..\src\ZeroAlloc.Jev.DependencyInjection\ZeroAlloc.Jev.DependencyInjection.csproj" />
    <ProjectReference Include="..\..\src\ZeroAlloc.Jev.Generator\ZeroAlloc.Jev.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      UndefineProperties="PublishAot" />
    <ProjectReference Include="..\..\src\ZeroAlloc.Jev.Analyzers\ZeroAlloc.Jev.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      UndefineProperties="PublishAot" />
  </ItemGroup>
</Project>
