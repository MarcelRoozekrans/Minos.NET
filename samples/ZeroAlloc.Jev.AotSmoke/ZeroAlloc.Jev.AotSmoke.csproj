<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ZeroAlloc.Jev.AotSmoke</RootNamespace>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ZeroAlloc.Jev\ZeroAlloc.Jev.csproj" />
    <!-- AddJevClient, so registration, resolution and the factory's HttpClient run under Native AOT. -->
    <ProjectReference Include="..\..\src\ZeroAlloc.Jev.DependencyInjection\ZeroAlloc.Jev.DependencyInjection.csproj" />
    <ProjectReference Include="..\..\src\ZeroAlloc.Jev.Generator\ZeroAlloc.Jev.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      UndefineProperties="PublishAot" />
    <ProjectReference Include="..\..\src\ZeroAlloc.Jev.Analyzers\ZeroAlloc.Jev.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      UndefineProperties="PublishAot" />
    <PackageReference Include="ZeroAlloc.TestHelpers" PrivateAssets="all" />
    <!-- A real LoggerFactory, so the logging checks run the path a consumer's app runs under Native AOT. -->
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <!-- ConfigurationBuilder and AddInMemoryCollection, so binding through AddJevClient runs under Native AOT. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" />
  </ItemGroup>

  <PropertyGroup>
    <!--
      The coverage test compares the generated files it gets by rerunning the generators with the ones this build
      wrote, so the build writes them, under obj like the rest of its intermediate output.
    -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/$(RuntimeIdentifier)/generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <!--
    Writes this project's compiler inputs: its sources, references, analyzers, editorconfig files, additional files,
    defines, parser features and the options the compiler takes from properties. The entry-point coverage test,
    tests/ZeroAlloc.Jev.AotSmoke.Tests, rebuilds the same compilation from them, generators included, to check that
    every public entry point is declared by a smoke check that really calls it. Each list property has its ';'
    separators turned into ',' so it stays one line.
  -->
  <Target Name="JevWriteCompileInputs" AfterTargets="CoreCompile">
    <ItemGroup>
      <_JevCompileInput Include="@(Compile->'compile|%(FullPath)')" />
      <_JevCompileInput Include="@(ReferencePath->'reference|%(FullPath)')" />
      <_JevCompileInput Include="@(Analyzer->'analyzer|%(FullPath)')" />
      <_JevCompileInput Include="@(EditorConfigFiles->'editorconfig|%(FullPath)')" />
      <_JevCompileInput Include="@(AdditionalFiles->'additionalfile|%(FullPath)')" />
      <_JevCompileInput Include="define|$(DefineConstants.Replace(';', ','))" />
      <_JevCompileInput Include="features|$(Features.Replace(';', ','))" />
      <_JevCompileInput Include="interceptorsnamespaces|$(InterceptorsNamespaces.Replace(';', ','))" />
      <_JevCompileInput Include="interceptorspreviewnamespaces|$(InterceptorsPreviewNamespaces.Replace(';', ','))" />
      <_JevCompileInput Include="langversion|$(LangVersion)" />
      <_JevCompileInput Include="nullable|$(Nullable)" />
      <_JevCompileInput Include="allowunsafeblocks|$(AllowUnsafeBlocks)" />
      <_JevCompileInput Include="nowarn|$(NoWarn.Replace(';', ','))" />
      <_JevCompileInput Include="warninglevel|$(WarningLevel)" />
      <_JevCompileInput Include="generatedfiles|$([System.IO.Path]::GetFullPath('$(CompilerGeneratedFilesOutputPath)'))" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)compile-inputs.txt"
                      Lines="@(_JevCompileInput)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
