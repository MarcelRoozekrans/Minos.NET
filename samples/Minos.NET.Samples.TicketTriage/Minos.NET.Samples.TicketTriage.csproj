<Project Sdk="Microsoft.NET.Sdk">
  <!-- Cookbook sample: triages a ticket set with the escalation pipeline and reports the cost and the escalation rate. -->
  <PropertyGroup>
    <TargetFrameworks />
    <TargetFramework>$(MinosAppTargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Minos.Samples.TicketTriage</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Minos.NET.Evaluation\Minos.NET.Evaluation.csproj" />
    <ProjectReference Include="..\..\src\Minos.NET.SystemOne\Minos.NET.SystemOne.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Minos.NET.Samples.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
  </ItemGroup>
</Project>
