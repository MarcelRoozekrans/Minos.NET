<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>ZeroAlloc.Jev</RootNamespace>
    <PackageId>ZeroAlloc.Jev</PackageId>
    <Title>ZeroAlloc.Jev</Title>
    <Description>Unofficial .NET client for TypeSafe AI's Jev System One model, directly or through OpenRouter. Source-generated, Native AOT-compatible and allocation-conscious, with typed questions and answers and Result-based errors. Not affiliated with or endorsed by TypeSafe AI.</Description>
    <!-- Zero runtime reflection by design; enables IsTrimmable and the IL2026/IL3050 analyzers. -->
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      HLQ001 fires only in ZeroAlloc.Rest.Generator's own generated __CreateHttpError (IJevApi.g.cs), which this
      project does not author and cannot edit; .editorconfig severity overrides cannot scope generated code.
      Remove once ZeroAlloc-Net/ZeroAlloc.Rest#335 ships: https://github.com/ZeroAlloc-Net/ZeroAlloc.Rest/issues/335
    -->
    <NoWarn>$(NoWarn);HLQ001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Build the [JevQuestions] source generator, its analyzer and its code fixes first and ship them in this
      package under analyzers/dotnet/cs. ZeroAlloc.Jev itself does not run any of them, and none may become a
      package dependency.
    -->
    <ProjectReference Include="..\ZeroAlloc.Jev.Generator\ZeroAlloc.Jev.Generator.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <ProjectReference Include="..\ZeroAlloc.Jev.Analyzers\ZeroAlloc.Jev.Analyzers.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <ProjectReference Include="..\ZeroAlloc.Jev.CodeFixes\ZeroAlloc.Jev.CodeFixes.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ZeroAlloc.Jev.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZeroAlloc.Resilience" />
    <PackageReference Include="ZeroAlloc.Rest" />
    <PackageReference Include="ZeroAlloc.Rest.SystemTextJson" />
    <PackageReference Include="ZeroAlloc.Results" />
  </ItemGroup>

  <!-- Pack the generator, analyzer and code fixes from their real build output rather than a hard-coded bin path (#14). -->
  <Target Name="PackJevGenerator" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="..\ZeroAlloc.Jev.Generator\ZeroAlloc.Jev.Generator.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_JevAnalyzerAssemblies" />
    </MSBuild>
    <MSBuild Projects="..\ZeroAlloc.Jev.Analyzers\ZeroAlloc.Jev.Analyzers.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_JevAnalyzerAssemblies" />
    </MSBuild>
    <MSBuild Projects="..\ZeroAlloc.Jev.CodeFixes\ZeroAlloc.Jev.CodeFixes.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_JevAnalyzerAssemblies" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_JevAnalyzerAssemblies)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>
</Project>
