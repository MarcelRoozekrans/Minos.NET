<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Minos.Evaluation</RootNamespace>
    <PackageId>Minos.NET.Evaluation</PackageId>
    <Title>Minos.NET.Evaluation</Title>
    <Description>Labelled decision datasets for Minos.NET: a versioned JSONL format that pairs each item's questions and state with the expected answers, and a loader that reports every problem with its line number. Native AOT-compatible.</Description>
    <PackageTags>$(PackageTags);evaluation;dataset</PackageTags>
    <!-- No published version to compare with yet. Set to the first published version after it ships. -->
    <MinosNoValidationBaseline>true</MinosNoValidationBaseline>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- The package's own README, in place of the root README that Directory.Build.props packs into every package. -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\README.md" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Minos.NET\Minos.NET.csproj" />
    <PackageReference Include="ZeroAlloc.Results" />
  </ItemGroup>
</Project>
