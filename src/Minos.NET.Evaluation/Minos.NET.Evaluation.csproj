<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Minos.Evaluation</RootNamespace>
    <PackageId>Minos.NET.Evaluation</PackageId>
    <Title>Minos.NET.Evaluation</Title>
    <Description>Labelled decision datasets for Minos.NET: a versioned JSONL format that pairs each item's state and questions with the expected answers, a loader that reports every problem with its line number, a runner that sends the items through any IDecisionClient and keeps the results in a file, and a calibration report built from them. Native AOT-compatible.</Description>
    <PackageTags>$(PackageTags);evaluation;dataset</PackageTags>
    <!-- First published at 1.2.0, so its public API is compared with that version. -->
    <PackageValidationBaselineVersion>1.2.0</PackageValidationBaselineVersion>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- The package's own README, in place of the root README that Directory.Build.props packs into every package. -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\README.md" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Minos.NET\Minos.NET.csproj" />
    <PackageReference Include="ZeroAlloc.Results" />
  </ItemGroup>
</Project>
