<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Minos.Extensions.AI</RootNamespace>
    <PackageId>Minos.NET.Extensions.AI</PackageId>
    <Title>Minos.NET.Extensions.AI</Title>
    <Description>An IDecisionClient for Minos.NET over any Microsoft.Extensions.AI IChatClient: OpenAI, OpenRouter, Azure, Ollama or any other chat model answers Noul, Choice and Score questions, and each answer says whether its probabilities came from the model's logprobs or from the model's own estimate. Native AOT-compatible.</Description>
    <PackageTags>$(PackageTags);extensions-ai;ichatclient;llm</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- First published at 1.5.0, so its public API is compared with that version. -->
    <PackageValidationBaselineVersion>1.5.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- The package's own README, in place of the root README that Directory.Build.props packs into every package. -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\README.md" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Minos.NET\Minos.NET.csproj" />
    <!-- The provider-neutral registration, which the bridge's own registration builds on. -->
    <ProjectReference Include="..\Minos.NET.DependencyInjection\Minos.NET.DependencyInjection.csproj" />
    <!-- IChatClient, ChatOptions and ChatResponse. -->
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <!-- The OpenAI SDK's ChatCompletion, the raw representation that carries the logprobs, and its ClientResultException. -->
    <PackageReference Include="OpenAI" />
    <PackageReference Include="ZeroAlloc.Results" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Minos.NET.Extensions.AI.Tests" />
  </ItemGroup>
</Project>
