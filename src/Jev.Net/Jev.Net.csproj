<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Jev.Net</RootNamespace>
    <PackageId>Jev.Net</PackageId>
    <Title>Jev.Net</Title>
    <Description>Unofficial .NET client for TypeSafe AI's Jev System One model. Source-generated, Native AOT-compatible and allocation-conscious. Not affiliated with or endorsed by TypeSafe AI.</Description>
    <!-- Zero runtime reflection by design; enables IsTrimmable and the IL2026/IL3050 analyzers. -->
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      HLQ001 false positive: ZeroAlloc.Rest.Generator's own generated JevApiClient (IJevApi.g.cs, which this
      project does not author and cannot edit) copies response headers into a Dictionary and assigns it to an
      IReadOnlyDictionary field once per HttpError. NetFabric.Hyperlinq.Analyzer flags every such assignment as
      enumerator boxing regardless of call frequency; there is no hot loop here to fix.
    -->
    <!--
      RS0026 false positive: JevClient's two public constructors both end in an optional JevClientOptions?
      by design (one bare, one over a caller-owned HttpClient) - the spec fixes this shape. They are not
      ambiguous (they differ in their leading parameter) and neither is expected to gain further overloads.
    -->
    <NoWarn>$(NoWarn);HLQ001;RS0026</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Build the [JevQuestions] source generator first and ship it in this package under analyzers/dotnet/cs.
      Jev.Net itself does not run it, and it must not become a package dependency.
    -->
    <ProjectReference Include="..\Jev.Net.Generators\Jev.Net.Generators.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <None Include="..\Jev.Net.Generators\bin\$(Configuration)\netstandard2.0\Jev.Net.Generators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jev.Net.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZeroAlloc.Rest" />
    <PackageReference Include="ZeroAlloc.Rest.SystemTextJson" />
    <PackageReference Include="ZeroAlloc.Results" />
  </ItemGroup>
</Project>
