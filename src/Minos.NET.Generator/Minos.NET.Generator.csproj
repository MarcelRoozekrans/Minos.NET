<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Roslyn loads generators as netstandard2.0 assemblies -->
    <!-- Directory.Build.props sets TargetFrameworks for the libraries; clearing it keeps this a single-target project, which Minos.NET.csproj packs through GetTargetPath -->
    <TargetFrameworks />
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Minos.Generator</RootNamespace>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- Shipped inside the Minos.NET package under analyzers/dotnet/cs, never on its own -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Minos.NET.Generator.Tests" />
  </ItemGroup>
</Project>
