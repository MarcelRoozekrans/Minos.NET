<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Minos.Tool</RootNamespace>
    <PackageId>Minos.NET.Tool</PackageId>
    <Title>Minos.NET.Tool</Title>
    <Description>The minos command line tool for Minos.NET: calibrates a decision model against a labelled dataset, builds the calibration report again from saved results, and checks that a provider conforms to the decision protocol.</Description>
    <PackageTags>$(PackageTags);tool;dotnet-tool;calibration;conformance;evaluation</PackageTags>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>minos</ToolCommandName>
    <!-- No published version to compare with yet. Set to the first published version after it ships. -->
    <MinosNoValidationBaseline>true</MinosNoValidationBaseline>
    <!-- The configuration binding is source-generated, as in Minos.NET.SystemOne, so no reflection binder is used. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Minos.NET\Minos.NET.csproj" />
    <ProjectReference Include="..\Minos.NET.SystemOne\Minos.NET.SystemOne.csproj" />
    <ProjectReference Include="..\Minos.NET.Evaluation\Minos.NET.Evaluation.csproj" />
    <ProjectReference Include="..\Minos.NET.Conformance\Minos.NET.Conformance.csproj" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="ZeroAlloc.Results" />
  </ItemGroup>

  <!-- The package's own README, in place of the root README that Directory.Build.props packs into every package. -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\README.md" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Minos.NET.Tool.Tests" />
  </ItemGroup>
</Project>
