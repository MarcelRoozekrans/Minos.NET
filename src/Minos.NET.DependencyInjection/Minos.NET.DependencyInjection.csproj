<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Minos.DependencyInjection</RootNamespace>
    <PackageId>Minos.NET.DependencyInjection</PackageId>
    <Title>Minos.NET.DependencyInjection</Title>
    <Description>Registers Minos.NET's IDecisionClient in a .NET host, as a default client or as keyed clients, from a client factory, with a pipeline of stages the container builds once. Protocol packages such as Minos.NET.SystemOne build their registrations on it. Native AOT-compatible.</Description>
    <PackageTags>$(PackageTags);dependency-injection</PackageTags>
    <!-- Hand-written registrations with no reflection: enables IsTrimmable and the trim and AOT analyzers. -->
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Minos.NET\Minos.NET.csproj" />
    <!-- IServiceCollection and its TryAdd extensions: the registrations need nothing else. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- DecisionClientRegistration and the builder's internal constructor, for the protocol packages' registrations. -->
    <InternalsVisibleTo Include="Minos.NET.SystemOne" />
    <InternalsVisibleTo Include="Minos.NET.OpenAI" />
  </ItemGroup>
</Project>
