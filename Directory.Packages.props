<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Testing -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.13" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="ZeroAlloc.TestHelpers" Version="1.7.2" />
    <PackageVersion Include="WireMock.Net" Version="2.19.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" Version="1.1.4" />
    <!-- Analyzers -->
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.303" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="ZeroAlloc.Analyzers" Version="1.11.2" />
    <!-- Source generator and analyzers: compile against the first .NET 10 SDK's compiler so every .NET 10 consumer can load them -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <!-- HTTP client -->
    <PackageVersion Include="ZeroAlloc.Resilience" Version="3.3.5" />
    <PackageVersion Include="ZeroAlloc.Rest" Version="3.3.3" />
    <PackageVersion Include="ZeroAlloc.Rest.SystemTextJson" Version="3.3.3" />
    <PackageVersion Include="ZeroAlloc.Results" Version="1.4.4" />
    <!-- Telemetry: the attributes at run time, and the proxy generator bundled at analyzers/dotnet/cs. 1.11.0 is the floor: it sets error.type on the exception path and can leave the exception message out of the span status, #184. -->
    <PackageVersion Include="ZeroAlloc.Telemetry" Version="1.11.0" />
    <!--
      Logging: the library's floor is the first .NET 10 release, so consumers on any 10.0.x resolve without a conflict.
      Microsoft.Extensions.Logging, for the tests' and the AOT smoke app's LoggerFactory, follows Diagnostics.Testing's
      own floor, 10.0.12: a lower direct reference would be an NU1605 downgrade.
    -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <!--
      Test and smoke-app only: a generic host for the startup validation tests, and in-memory configuration. They follow
      Microsoft.Extensions.Logging's 10.0.12, so nothing they bring is an NU1605 downgrade.
    -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <!-- The docs tests only: compiles the observability page's OpenTelemetry wiring. The library takes no OpenTelemetry
      dependency. -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <!--
      The SystemOne package's IHttpClientFactory and AddHttpClient. Its floor is the first .NET 10 release, as for
      Logging.Abstractions, so consumers on any 10.0.x resolve without a conflict.
    -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <!--
      The DI package's IServiceCollection and TryAdd extensions. Its floor follows the core package's
      ZeroAlloc.Resilience, which already requires 10.0.12: a lower direct reference would be an NU1605 downgrade.
    -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <!--
      The SystemOne package's Bind over IConfiguration. It brings Configuration.Binder, whose source generator the
      SystemOne package enables so binding uses no reflection. Its floor is the first .NET 10 release, as for
      Microsoft.Extensions.Http.
    -->
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
    <!--
      The caching package's IMemoryCache and IDistributedCache. Its floor is the first .NET 10 release, as for the other
      Microsoft packages. Not HybridCache: every app that calls AddHybridCache gets AOT warnings from its reflection-based
      JSON serializer factory, dotnet/extensions#5624.
    -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.0" />
    <!-- Test and smoke-app only: MemoryCache and MemoryDistributedCache, through AddMemoryCache and AddDistributedMemoryCache. -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.13" />
    <!-- The rate-limiting package's RateLimiter. Its floor is the first .NET 10 release, as for the other Microsoft packages. -->
    <PackageVersion Include="System.Threading.RateLimiting" Version="10.0.0" />
    <!-- Runtime question set validation: its generators validate Minos.NET's own specs; NuGet still flows them to consumers, where they stay inert, NuGet/Home#6720 -->
    <PackageVersion Include="ZeroAlloc.Validation" Version="2.3.3" />
    <!-- Benchmarks -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <!--
      Benchmark-only: the community Jev clients the comparison harness measures. Only
      benchmarks/Minos.NET.Benchmarks.Compare references them; nothing in src/ or the library's tests does. The
      versions are the ones docs/plans/2026-10-04-phase-5.2-library-checks.md checked.
    -->
    <PackageVersion Include="JevSharp" Version="0.2.0" />
    <PackageVersion Include="TypeSafe.AI.Sdk" Version="0.7.0" />
    <PackageVersion Include="Jev.Net" Version="0.5.0" />
  </ItemGroup>
</Project>
