<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Testing -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.10.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="ZeroAlloc.TestHelpers" Version="1.3.3" />
    <PackageVersion Include="WireMock.Net" Version="2.18.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" Version="1.1.4" />
    <!-- Analyzers -->
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.290" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.0" />
    <PackageVersion Include="NetFabric.Hyperlinq.Analyzer" Version="2.3.0" />
    <PackageVersion Include="ZeroAlloc.Analyzers" Version="1.5.4" />
    <!-- Source generator and analyzers: compile against the first .NET 10 SDK's compiler so every .NET 10 consumer can load them -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <!-- HTTP client -->
    <PackageVersion Include="ZeroAlloc.Resilience" Version="3.3.0" />
    <PackageVersion Include="ZeroAlloc.Rest" Version="3.1.0" />
    <PackageVersion Include="ZeroAlloc.Rest.SystemTextJson" Version="3.1.0" />
    <PackageVersion Include="ZeroAlloc.Results" Version="1.2.4" />
    <!-- Telemetry: the attributes at run time, and the proxy generator bundled at analyzers/dotnet/cs. 1.10.0 is the floor: it allows several [TraceTag] on one parameter, #181. -->
    <PackageVersion Include="ZeroAlloc.Telemetry" Version="1.10.0" />
    <!--
      Logging: the library's floor is the first .NET 10 release, so consumers on any 10.0.x resolve without a conflict.
      Microsoft.Extensions.Logging, for the tests' and the AOT smoke app's LoggerFactory, follows Diagnostics.Testing's
      own floor, 10.0.12: a lower direct reference would be an NU1605 downgrade.
    -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <!--
      Test and smoke-app only: a generic host for the startup validation tests, and in-memory configuration. They follow
      Microsoft.Extensions.Logging's 10.0.12, so nothing they bring is an NU1605 downgrade.
    -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <!--
      The DI package's IHttpClientFactory and AddHttpClient. Its floor is the first .NET 10 release, as for
      Logging.Abstractions, so consumers on any 10.0.x resolve without a conflict.
    -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <!--
      The DI package's Bind over IConfiguration. It brings Configuration.Binder, whose source generator the DI package
      enables so binding uses no reflection. Its floor is the first .NET 10 release, as for Microsoft.Extensions.Http.
    -->
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
    <!-- Runtime question set validation: its generators validate ZeroAlloc.Jev's own specs; NuGet still flows them to consumers, where they stay inert, NuGet/Home#6720 -->
    <PackageVersion Include="ZeroAlloc.Validation" Version="2.0.3" />
    <!-- Benchmarks -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
</Project>
