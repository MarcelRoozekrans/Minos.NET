<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Minos.Docs.Tests</RootNamespace>
  </PropertyGroup>

  <!-- The code behind the user docs: every C# block in docs/ is a #region here, written in by mdsnippets, and each
       pattern's example runs as a test. Public API only, like a consumer's project. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Minos.NET\Minos.NET.csproj" />
    <ProjectReference Include="..\..\src\Minos.NET.SystemOne\Minos.NET.SystemOne.csproj" />
    <ProjectReference Include="..\..\src\Minos.NET.OpenAI\Minos.NET.OpenAI.csproj" />
    <ProjectReference Include="..\..\src\Minos.NET.Caching\Minos.NET.Caching.csproj" />
    <ProjectReference Include="..\..\src\Minos.NET.RateLimiting\Minos.NET.RateLimiting.csproj" />
    <ProjectReference Include="..\..\src\Minos.NET.DependencyInjection\Minos.NET.DependencyInjection.csproj" />
    <ProjectReference Include="..\..\src\Minos.NET.Conformance\Minos.NET.Conformance.csproj" />
    <ProjectReference Include="..\..\src\Minos.NET.Evaluation\Minos.NET.Evaluation.csproj" />
    <!-- The minos tool (internals visible), so the command line section of the datasets page is checked against its readers. -->
    <ProjectReference Include="..\..\src\Minos.NET.Tool\Minos.NET.Tool.csproj" />
    <!-- The provider-switch sample, so the Providers page's side-by-side table is compared with its replayed answers. -->
    <ProjectReference Include="..\..\samples\Minos.NET.Samples.ProviderSwitch\Minos.NET.Samples.ProviderSwitch.csproj" />
    <ProjectReference Include="..\..\src\Minos.NET.Generator\Minos.NET.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Minos.NET.Analyzers\Minos.NET.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Host.CreateApplicationBuilder and its configuration, for the dependency injection page. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- AddMemoryCache, for the pipeline page's caching snippets. -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <!-- FakeLogger, for the observability page's logging example. -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
    <!-- AddOpenTelemetry, AddSource and AddMeter, for the observability page's wiring snippet. -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="ZeroAlloc.TestHelpers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>contentfiles;build</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
